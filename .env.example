# CoreWorks — environment variables
# Copy to `.env` and fill in. Never commit `.env`.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local Postgres, or a Supabase/Neon/Railway connection string.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/coreworks?schema=public"

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Server-only. Never expose this or prefix it with NEXT_PUBLIC_.
AUTH_SECRET=""

# Canonical origin of the deployment.
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Safe to expose — used for absolute links in the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File storage (Phase 12 — attachments). Optional until then.
# ---------------------------------------------------------------------------
# S3-compatible endpoint, e.g. Supabase Storage.
STORAGE_URL=""
STORAGE_BUCKET=""
STORAGE_KEY=""
STORAGE_SECRET=""

# ---------------------------------------------------------------------------
# Email (Phase 11 — notifications). Optional until then.
# ---------------------------------------------------------------------------
EMAIL_FROM=""
SMTP_URL=""
