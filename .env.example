# CoreWorks — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
#
# This file lists what the application ACTUALLY reads, verified against the
# source. `npm run check:env` validates a real environment against the same
# rules before a process starts serving.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Read by src/lib/db.ts (runtime), prisma.config.ts (migrations), the seed,
# and the job runner. PostgreSQL 14 or newer.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/coreworks?schema=public"

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Read by Auth.js itself rather than by application code, which is why it
# appears nowhere in a grep of src/.
#
# Generate with: openssl rand -base64 32
# Server-only. Never expose this or prefix it with NEXT_PUBLIC_.
# Use a DIFFERENT value in every environment — a staging secret that also works
# in production means a staging token is a production session.
AUTH_SECRET=""

# The canonical origin, exactly as users type it, including scheme and any
# port, with no trailing slash. A mismatch scopes session cookies to the wrong
# host, which presents as an endless redirect back to the sign-in page rather
# than as an error.
# Must be https in production.
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# `production` for a real deployment. `npm run build` sets it for the build;
# the running process needs it too.
# NODE_ENV="production"

# Port to listen on. Next reads this directly; most platforms set it for you.
# Defaults to 3000.
# PORT="3000"

# ---------------------------------------------------------------------------
# Application (optional)
# ---------------------------------------------------------------------------
# Safe to expose — anything prefixed NEXT_PUBLIC_ is compiled into the browser
# bundle, so never give a secret this prefix.
#
# Read in exactly ONE place today: the development-only console line that logs
# a password-reset link. Nothing breaks if it is unset, but set it so it is
# correct when something does come to depend on it.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File storage (attachments). Reserved — nothing reads these yet.
# ---------------------------------------------------------------------------
# There is no upload path in the application; `Attachment` exists in the schema
# but nothing writes to it. See docs/deployment.md.
# S3-compatible endpoint, e.g. Supabase Storage.
STORAGE_URL=""
STORAGE_BUCKET=""
STORAGE_KEY=""
STORAGE_SECRET=""

# ---------------------------------------------------------------------------
# Email. Reserved — there is no mail transport in the codebase.
# ---------------------------------------------------------------------------
# Password-reset tokens and invitations are issued and stored but NOT sent.
# Notifications are in-app only. See docs/deployment.md for what wiring a
# transport requires.
EMAIL_FROM=""
SMTP_URL=""
